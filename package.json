{
  "name": "limmingjie-ai-pm-workbuddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LMJ AI PM Portfolio · WorkBuddy Edition",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run qr && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "qr": "node scripts/generate-qr.mjs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "sizes": "node scripts/generate-image-sizes.mjs",
    "build:offline": "npm run qr && tsc --noEmit && vite build --config vite.config.offline.ts && node scripts/inline-offline.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.2.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
